# Copy to hosts.env at repository root and edit locally.
# R1/R2/R3: experiment/private-network IP addresses used for TCP bootstrap.
# *_SSH: names or addresses reachable by SSH from your laptop/control machine.
# Use the CloudLab login shown on your experiment page, e.g. user@node.example.
R1=10.0.0.1
R2=10.0.0.2
R3=10.0.0.3
R1_SSH=YOUR_USER@NODE1_SSH_HOST
R2_SSH=YOUR_USER@NODE2_SSH_HOST
R3_SSH=YOUR_USER@NODE3_SSH_HOST
CLIENT_SSH=YOUR_USER@NODE4_SSH_HOST
IB_DEV=mlx4_0
IB_PORT=1
CONTROL_PORT=29660
RELEASE_PORT=29670
# Public GitHub repository; used only by 'cluster.sh sync'.
GITHUB_REPO=YOUR_ACCOUNT/YOUR_REPOSITORY
# Name of checkout directory on each node, relative to $HOME.
REMOTE_DIR=rdma-queue
